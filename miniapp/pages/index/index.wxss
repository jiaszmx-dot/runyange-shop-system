.hero {
  margin: 20rpx;
  text-align: center;
  background: linear-gradient(120deg, #7e311a, #f2bd2f);
  color: #fff;
}

.logo {
  width: 180rpx;
  margin: 0 auto;
}

.title {
  font-size: 36rpx;
  font-weight: 700;
  margin-top: 14rpx;
}

.sub {
  margin-top: 8rpx;
  opacity: 0.9;
}

.section {
  margin: 20rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.item {
  padding: 10rpx 0;
  border-bottom: 1rpx solid #eef0f5;
}

.actions {
  margin: 20rpx;
  display: grid;
  gap: 12rpx;
}
